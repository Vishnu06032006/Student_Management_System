PORT=5000
MONGO_URI=mongodb://localhost:27017/sms_dev
NODE_ENV=development
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=10

# Used once by `npm run seed:admin` to bootstrap the first Admin account.
ADMIN_LOGIN_ID=ADM001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@2026

# Optional. If SMTP_HOST is unset, password-reset OTP emails are logged to
# the server console instead of sent (dev-friendly, no real inbox needed).
# For Gmail: use an App Password, not your normal password, with smtp.gmail.com:587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@student-management.local
